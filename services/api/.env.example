# ─── Server ─────────────────────────────────────────────
PORT=4001
NODE_ENV=development
API_PREFIX=/api/v1

# ─── Database ───────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mufasal?schema=public

# ─── JWT ────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ─── Redis ──────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=mufasal:

# ─── CORS ───────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ─── Storage ────────────────────────────────────────────
STORAGE_PATH=./uploads
MAX_FILE_SIZE=5242880

# ─── Email (SMTP) ──────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
SMTP_FROM=noreply@mufasal.com
SMTP_FROM_NAME=MUFASAL

# ─── SMS (Twilio) ──────────────────────────────────────
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+966500000000

# ─── Firebase (Push Notifications) ─────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-private-key-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email
FIREBASE_CLIENT_ID=your-client-id

# ─── Payment Gateways ──────────────────────────────────
# Mada (Moyasar)
MADA_API_KEY=your-mada-api-key
MADA_PUBLISHABLE_KEY=your-mada-publishable-key
MADA_WEBHOOK_SECRET=your-mada-webhook-secret

# Visa/Mastercard (Stripe)
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# STC Pay
STCPAY_API_KEY=your-stcpay-api-key
STCPAY_MERCHANT_ID=your-stcpay-merchant-id
STCPAY_API_URL=https://api.stcpay.com.sa/v1

# Tamara
TAMARA_API_KEY=your-tamara-api-key
TAMARA_API_URL=https://api.tamara.co/v1

# Tabby
TABBY_API_KEY=your-tabby-api-key
TABBY_API_URL=https://api.tabby.ai/api/v2

# Sadad
SADAD_MERCHANT_ID=your-sadad-merchant-id
SADAD_TERMINAL_ID=your-sadad-terminal-id
SADAD_API_KEY=your-sadad-api-key

# ─── Delivery Integrations ─────────────────────────────
# Uber Direct
UBER_CLIENT_ID=your-uber-client-id
UBER_CLIENT_SECRET=your-uber-client-secret
UBER_API_URL=https://api.uber.com/v1

# Careen
CAREEN_API_KEY=your-careen-api-key
CAREEN_API_URL=https://api.careen.app/v1

# Jeeny
JEENY_API_KEY=your-jeeny-api-key
JEENY_API_URL=https://api.jeeny.com/v1

# SMSA Express
SMSA_API_KEY=your-smsa-api-key
SMSA_PASSPHRASE=your-smsa-passphrase
SMSA_ACCOUNT_NUMBER=your-smsa-account
SMSA_API_URL=https://api.smsaexpress.com/v1

# Aramex
ARAMEX_USERNAME=your-aramex-username
ARAMEX_PASSWORD=your-aramex-password
ARAMEX_ACCOUNT_NUMBER=your-aramex-account
ARAMEX_ACCOUNT_PIN=your-aramex-pin
ARAMEX_ENTITY=your-aramex-entity
ARAMEX_API_URL=https://ws.aramex.net/shippingapi/v1

# ─── AI Providers ──────────────────────────────────────
# المزود الافتراضي (gemini, openai, deepseek, ollama)
AI_PROVIDER=gemini

# Google Gemini (مجاني: 15 RPM, 1M tokens/day)
GEMINI_API_KEY=your-gemini-api-key

# OpenAI (مدفوع)
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek (رخيص جداً)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat

# Ollama (مجاني 100% — محلي)
# التثبيت: https://ollama.ai
# التشغيل: ollama serve
# تحميل نموذج: ollama pull llama3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ─── ZATCA (E-Invoice) ────────────────────────────────
ZATCA_API_URL=https://api.my.zatca.gov.sa/v2
ZATCA_ENVIRONMENT=simulation
ZATCA_SELLER_NAME=MUFASAL Tailoring
ZATCA_VAT_NUMBER=310000000000003
ZATCA_SELLER_CATEGORY=Retail
ZATCA_BUILDER_ID=your-builder-id

# ─── Accounting Integration ───────────────────────────
QUICKBOOKS_CLIENT_ID=your-quickbooks-client-id
QUICKBOOKS_CLIENT_SECRET=your-quickbooks-client-secret
QUICKBOOKS_COMPANY_ID=your-quickbooks-company-id
QAID_API_KEY=your-qaid-api-key
QUYOUD_API_KEY=your-quyoud-api-key
