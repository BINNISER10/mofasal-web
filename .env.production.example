# ─── MUFASAL Production Environment ─────────────────────
# انسخ هذا الملف إلى .env.production على السيرفر
# وعدّل القيم حسب إعداداتك

# ─── Server ─────────────────────────────────────────────
PORT=4001
NODE_ENV=production
API_PREFIX=/api/v1

# ─── Database ───────────────────────────────────────────
POSTGRES_USER=mufasal
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=mufasal
DATABASE_URL=postgresql://mufasal:CHANGE_ME_STRONG_PASSWORD@pgbouncer:6432/mufasal?pgbouncer=true
DIRECT_DATABASE_URL=postgresql://mufasal:CHANGE_ME_STRONG_PASSWORD@postgres:5432/mufasal

# ─── JWT ────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ─── Redis ──────────────────────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_PREFIX=mufasal:

# ─── CORS ───────────────────────────────────────────────
CORS_ORIGIN=https://mufasal.com

# ─── Frontend ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://mufasal.com/api/v1
NEXT_PUBLIC_APP_URL=https://mufasal.com

# ─── AI Providers (Zero-Cost) ───────────────────────────
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ─── Email (SMTP) ──────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key
SMTP_FROM=noreply@mufasal.com
SMTP_FROM_NAME=MUFASAL

# ─── SMS (Twilio) ──────────────────────────────────────
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+966500000000

# ─── Payment Gateways ──────────────────────────────────
MADA_API_KEY=your-mada-api-key
STRIPE_SECRET_KEY=your-stripe-secret-key

# ─── Delivery ──────────────────────────────────────────
SMSA_API_KEY=your-smsa-api-key
UBER_CLIENT_ID=your-uber-client-id
