# ============================================================
# MUFASAL — Environment Variables (Example)
# ============================================================
# Copy this to .env and fill in your values.
# See .env.production for the full production template.
# ============================================================

# ─── Database ───────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mufasal
DIRECT_DATABASE_URL=

# S3 Storage
S3_REGION=me-central-1
S3_BUCKET=mufasal-uploads
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
S3_CDN_URL=

# Reports
REPORTS_API_KEY=

# ─── JWT ────────────────────────────────────────────────
JWT_SECRET=mufasal-super-secret-key-change-in-production-2026
JWT_REFRESH_SECRET=mufasal-refresh-secret-change-in-production-2026
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ─── Server ─────────────────────────────────────────────
PORT=4001
NODE_ENV=development
API_PREFIX=/api/v1

# ─── Redis (optional, uses in-memory fallback) ───────────
REDIS_URL=redis://localhost:6379

# ─── CORS ───────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ─── Storage ────────────────────────────────────────────
STORAGE_PATH=./uploads

# ─── Email ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@mufasal.com
SMTP_FROM_NAME=MUFASAL

# ─── Firebase (placeholder — okay for dev) ──────────────
FIREBASE_PROJECT_ID=mufasal-dev
FIREBASE_PRIVATE_KEY=placeholder
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@mufasal-dev.iam.gserviceaccount.com

# ─── Twilio ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=placeholder
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── AI Providers ──────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# ─── Payment Gateways ──────────────────────────────────
MADA_API_KEY=
STCPAY_API_KEY=
TAMARA_API_KEY=
TABBY_API_KEY=

# ─── ZATCA ─────────────────────────────────────────────
ZATCA_API_URL=https://gw-fatoora.zatca.gov.sa
ZATCA_ENVIRONMENT=simulation
ZATCA_SELLER_NAME=MUFASAL
ZATCA_VAT_NUMBER=310000000000003

# ─── Frontend ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4001/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
