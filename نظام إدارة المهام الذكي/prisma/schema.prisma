datasource db {
  provider = "sqlite"
  url      = "file:./tasks.db"
}

generator client {
  provider = "prisma-client-js"
}

model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  dueDate     DateTime?
  priority    String   @default("متوسطة") // منخفضة، متوسطة، عالية
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
