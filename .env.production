# ============================================================
# MUFASAL — Production Environment Configuration
# ============================================================
# Copy this to .env and fill in your production values.
# NEVER commit .env files with real secrets to version control.
# ============================================================

# ─── Node Environment ────────────────────────────────────
NODE_ENV=production
PORT=4001

# ─── Database (PostgreSQL) — عبر PgBouncer ──────────────
DATABASE_URL=postgresql://mufasal:CHANGE_ME@pgbouncer:6432/mufasal?pgbouncer=true
DIRECT_DATABASE_URL=postgresql://mufasal:CHANGE_ME@postgres:5432/mufasal

# ─── Redis ──────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── S3 Storage ─────────────────────────────────────────
S3_REGION=me-central-1
S3_BUCKET=mufasal-uploads
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_ENDPOINT=
S3_CDN_URL=https://cdn.mufasal.com

# ─── JWT Authentication ─────────────────────────────────
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_64
JWT_REFRESH_SECRET=CHANGE_ME_generate_with_openssl_rand_64
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ───────────────────────────────────────────────
CORS_ORIGINS=https://mufasal.com,https://www.mufasal.com

# ─── API Prefix ─────────────────────────────────────────
API_PREFIX=/api/v1

# ─── Storage (uploads) ──────────────────────────────────
STORAGE_PATH=./uploads
STORAGE_PROVIDER=local

# ─── Email (SMTP) ──────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@mufasal.com
SMTP_PASS=CHANGE_ME
SMTP_FROM=notifications@mufasal.com
SMTP_FROM_NAME=MUFASAL

# ─── Firebase Cloud Messaging ───────────────────────────
FIREBASE_PROJECT_ID=mufasal-production
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCHANGE_ME\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@mufasal-production.iam.gserviceaccount.com

# ─── Twilio (SMS) ──────────────────────────────────────
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_PHONE_NUMBER=+966500000000

# ─── AI Providers ──────────────────────────────────────
OPENAI_API_KEY=CHANGE_ME
GEMINI_API_KEY=CHANGE_ME
DEEPSEEK_API_KEY=CHANGE_ME

# ─── Uber Delivery API ──────────────────────────────────
UBER_API_CLIENT_ID=CHANGE_ME
UBER_API_CLIENT_SECRET=CHANGE_ME

# ─── Careen Delivery API ────────────────────────────────
CAREEN_API_KEY=CHANGE_ME

# ─── Jeeny Delivery API ─────────────────────────────────
JEENY_API_KEY=CHANGE_ME

# ─── SMSA Express Shipping API ──────────────────────────
SMSA_API_KEY=CHANGE_ME

# ─── Aramex Shipping API ────────────────────────────────
ARAMEX_API_KEY=CHANGE_ME
ARAMEX_ACCOUNT_NUMBER=CHANGE_ME
ARAMEX_ACCOUNT_PIN=CHANGE_ME
ARAMEX_ACCOUNT_ENTITY=CHANGE_ME
ARAMEX_COUNTRY_CODE=SA

# ─── Payment Gateways ──────────────────────────────────
MADA_API_KEY=CHANGE_ME
MADA_PUBLISHABLE_KEY=CHANGE_ME

VISA_MASTERCARD_API_KEY=CHANGE_ME

STCPAY_API_KEY=CHANGE_ME
STCPAY_MERCHANT_ID=CHANGE_ME

TAMARA_API_KEY=CHANGE_ME
TAMARA_MERCHANT_ID=CHANGE_ME

TABBY_API_KEY=CHANGE_ME
TABBY_MERCHANT_ID=CHANGE_ME

SADAD_BANK_ACCOUNT=CHANGE_ME
SADAD_BANK_IBAN=SA_CHANGE_ME

# ─── ZATCA (Saudi Tax Authority - E-Invoicing) ─────────
ZATCA_API_URL=https://gw-fatoora.zatca.gov.sa
ZATCA_ENVIRONMENT=simulation
ZATCA_SELLER_NAME=MUFASAL for Tailoring
ZATCA_VAT_NUMBER=310000000000003
ZATCA_SELLER_CATEGORY=Retail
ZATCA_BUILDER_ID=
ZATCA_CSR=
ZATCA_OTP=
ZATCA_API_KEY=

# ─── Reports Microservice ──────────────────────────────
REPORTS_API_KEY=CHANGE_ME

# ─── Frontend URLs ─────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.mufasal.com/api/v1
NEXT_PUBLIC_APP_URL=https://mufasal.com
NEXT_PUBLIC_SOCKET_URL=wss://api.mufasal.com
NEXT_PUBLIC_MAPS_API_KEY=CHANGE_ME

# ─── Logging ───────────────────────────────────────────
LOG_LEVEL=warn
LOG_FORMAT=json
